# Supabase público usado pelo frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dados mock só podem ser importados em desenvolvimento quando esta flag for true.
VITE_PROSPECTING_ALLOW_DEMO_IMPORT=false

# Kill switch: mantenha desativado até validar consentimento, cadência e templates.
VITE_WHATSAPP_CONTACT_ENABLED=false

# Secrets de providers devem ser configurados apenas nas Supabase Edge Functions.
# GOOGLE_PLACES_API_KEY=
# APOLLO_API_KEY=

# Ambiente das Edge Functions: production, staging ou development
# ENVIRONMENT=production
# PROSPECTING_ALLOW_DEMO_IMPORT=false
